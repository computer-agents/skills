{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://computer-agents.com/schemas/skill-manifest.schema.json",
  "title": "Computer Agents Skill Manifest",
  "type": "object",
  "required": [
    "id",
    "slug",
    "name",
    "version",
    "summary",
    "category",
    "tags",
    "icon",
    "files",
    "install",
    "license"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 2 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "summary": { "type": "string", "minLength": 8 },
    "category": {
      "type": "string",
      "enum": ["research", "creative", "productivity", "development", "documents", "custom"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 },
      "minItems": 1
    },
    "icon": { "type": "string", "minLength": 2 },
    "source": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "owner": { "type": "string" },
        "repo": { "type": "string" }
      },
      "additionalProperties": true
    },
    "files": {
      "type": "object",
      "required": ["prompt", "code"],
      "properties": {
        "prompt": { "type": "string" },
        "code": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "install": {
      "type": "object",
      "required": ["marketplaceTemplateId", "icon", "category"],
      "properties": {
        "marketplaceTemplateId": { "type": "string" },
        "icon": { "type": "string" },
        "category": { "type": "string" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": true
    },
    "license": { "type": "string", "minLength": 2 }
  },
  "additionalProperties": true
}
